PUBLIC_ORIGIN=https://chat.zeekfusion.com
PORT=8787
ADMIN_PASSWORD=
ENCRYPTION_KEY=
# Required durable state on Render Free. Use a publishable/anon API key,
# never a database-wide service-role secret. STATE_ACCESS_KEY is chat-only.
STATE_URL=
STATE_API_KEY=
STATE_ACCESS_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Local development only; Render never uses local SQLite as durable storage.
DATA_PATH=.data/chat.sqlite
